use fs, env

# cuenta palabras de un fichero y muestra las 10 más frecuentes
fn count(path: str) -> map[str, int]!
	var c = map[str, int]()
	for line in fs.read(path)?
		for w in line.words()
			c[w.lower().strip(".,;:!?")] += 1
	c

fn main()
	let path = env.arg(1) or "in.txt"
	let c = count(path) or
		eprint(f"error: {it}")
		return
	for w, k in c.top(10)
		print(f"{k:6} {w}")
