use net, json

# Servidor HTTP minimo. Sin async, sin try/except: '?' propaga el error.

type Req
	path: str
	body: str

type Res
	code: int = 200
	body: str = ""

type Item
	name: str
	qty: int

fn handle(req: Req) -> Res!
	if req.path == "/boom"
		return err("boom", 500)
	if req.path == "/items"
		let items = [Item(name: "tornillo", qty: 40), Item(name: "tuerca", qty: 12)]
		return Res(body: json.str(items))
	Res(body: f"eco: {req.path.upper()}")

fn main()
	net.serve(8080, handle)?
